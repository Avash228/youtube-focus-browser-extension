{
  "manifest_version": 3,
  "name": "YouTube Focus — музыка и обучение",
  "version": "1.1.0",
  "description": "Скрывает развлекательные видео. Оставляет музыку и обучение. Локальные правила и исключения для каналов.",
  "permissions": ["storage"],
  "action": {
    "default_title": "YouTube Focus",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["classifier.js", "settings.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
